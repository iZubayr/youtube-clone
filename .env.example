# Ixtiyoriy: kompyuterda test qilish uchun .env nomi bilan nusxa oling.
# Render'da bularning hech biri majburiy emas.

PORT=5000

# Berilmasa, har ishga tushganda tasodifiy kalit yaratiladi
JWT_SECRET=bu_yerga_uzun_tasodifiy_matn
JWT_EXPIRES_IN=7d

# Frontend manzili (vergul bilan bir nechta). Hammasiga ruxsat: *
CORS_ORIGIN=*

# Maksimal video hajmi (MB)
MAX_FILE_MB=100

# Ixtiyoriy: videolar server o'chib yonganda ham qolishi uchun Cloudinary
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
